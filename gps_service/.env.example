# MQTT Broker
MQTT_BROKER_URL=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=smart-transport-gps-service

# GPS Simulation
POLL_INTERVAL=5.0
SIMULATION_MODE=true

# MQTT Retry
MQTT_RETRY_ATTEMPTS=3
MQTT_RETRY_DELAY=2.0

BACKEND_BASE_URL=http://localhost:8000
BACKEND_SERVICE_TOKEN=stk_dev_replace_me
BACKEND_REQUEST_TIMEOUT=10.0
BACKEND_PAGE_SIZE=100
DEVICE_ID_PREFIX=sim
