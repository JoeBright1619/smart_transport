# Auto detect text files and normalize line endings
* text=auto

# Ensure consistent line endings
*.js text
*.jsx text
*.ts text
*.tsx text
*.css text
*.scss text
*.html text
*.json text
*.md text

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg binary
*.ico binary

# Prevent line ending issues
*.sh text eol=lf
*.bat text eol=crlf